    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO \"OptimizacionRiego\" (id, lote_id, fecha, recomendacion_riego_mm, necesidad_riego_mm, humedad_actual, created_at) VALUES (gen_random_uuid(), $1, $2, $3, $4, $5, NOW()) ON CONFLICT (lote_id, fecha) DO UPDATE SET recomendacion_riego_mm = EXCLUDED.recomendacion_riego_mm, necesidad_riego_mm = EXCLUDED.necesidad_riego_mm, humedad_actual = EXCLUDED.humedad_actual",
        "options": {
          "queryReplacement": "=lote_id={{ $('Get Lotes').first().json.lote_id }},fecha={{ new Date().toISOString().split('T')[0] }},recomendacion_riego_mm={{ $('Prepare Optimization Data').item.json.recomendacion_riego_mm }},necesidad_riego_mm={{ $('Prepare Optimization Data').item.json.necesidad_riego_mm }},humedad_actual={{ $('Prepare Optimization Data').item.json.humedad_actual }}"
        }
      },
      "name": "Save Optimization",
